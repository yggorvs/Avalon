# NVIDIA ou outro endpoint compatível com Chat Completions.
AVALON_API_KEY=
AVALON_BASE_URL=https://integrate.api.nvidia.com/v1
# Confirme no catálogo do seu provedor quais modelos estão disponíveis.
AVALON_MODEL=meta/llama-3.1-70b-instruct
AVALON_DEVICE=auto
AVALON_WHISPER_MODEL=base
AVALON_VOICE=pt-BR-AntonioNeural
AVALON_SPEAK=false
# Opcional: diretório absoluto para memória local
# AVALON_DATA_DIR=C:/Users/seu_usuario/AvalonData

# Agente: também pode ser ativado com --agent ou pela interface.
AVALON_AGENT=false
AVALON_AGENT_STEPS=12
# Ferramentas de maior alcance: habilite somente as que pretende usar.
AVALON_ALLOW_SHELL=false
AVALON_ALLOW_VISION=false
AVALON_ALLOW_DESKTOP=false
# Lista JSON de caminhos absolutos. Vazio = pasta do usuário.
# AVALON_FILE_ROOTS='["C:/Users/seu_usuario", "D:/Projetos"]'
